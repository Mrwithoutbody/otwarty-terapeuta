# File names here are stable and the content behind them does not change;
# a new picture or font gets a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/illustrations/*
  Cache-Control: public, max-age=2592000
/logo.svg
  Cache-Control: public, max-age=2592000
/avatar-placeholder.webp
  Cache-Control: public, max-age=2592000
